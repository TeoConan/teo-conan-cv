include ../../mixins/_global-mixins.pug

.vlt-section__vertical-align

	.vlt-section__content

		//Ken Burn Effect
		.vlt-section__ken-burn-background

			img(src='assets/img/attachment-05.jpg', alt='')

		.container

			.row

				.col-lg-4.offset-lg-1

					+vlt_animation_block

						h1.has-white-color Contact

						.vlt-gap-50

						div.has-white-color

							h6.vlt-display-1.has-gray-color Email:
							.vlt-gap-5
							a(href='mailto:teo@teoconan.fr') teo@teoconan.fr

						.vlt-gap-30

						.vlt-gap-40

					.vlt-gap-70--sm

				.col-lg-6

					+vlt_animation_block({
						delay: '100ms'
					})

						h5.has-white-color I am always looking for great collaborators. If you are interested to get in touch, message me and make #[span.has-first-color something together!]

						.vlt-gap-40

						+vlt_button({
							title: 'Contact Me',
							link: 'https://devolution.studio/contact/#'
						})