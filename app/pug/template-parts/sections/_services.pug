include ../../mixins/_global-mixins.pug

.vlt-section__vertical-align

	.vlt-section__content

		//Particles
		.vlt-section__particles

			.vlt-particle.vlt-custom--1259.vlt-fade-in-right(style='background-image: url(assets/img/root/plus-light-pattern.png); animation-delay: 750ms;')
			.vlt-particle.vlt-custom--2355.vlt-fade-in-left(style='background-image: url(assets/img/root/elipse-light.png); animation-delay: 500ms;')

		.container

			.row

				.col-lg-2.offset-lg-1.d-none.d-lg-block

					+vlt_animation_block

						+vlt_counter_up({
							value: '5',
							suffix: '+',
						})

						.vlt-gap-40

						h6 Years #[br]Experience #[br]Working

				.col-lg-8.col-md-12

					+vlt_animation_block({
						delay: '100ms'
					})

						h4 #[span.has-first-color Adaptable] Full‑Stack Developer across #[span.has-first-color multiple] technical layers.

					.vlt-gap-50

					.row

						.col-md-6

							+vlt_animation_block({
								delay: '200ms'
							})

								+vlt_services({
									title: 'Software Architecture',
									text: 'Definition of application structure, technical choices, and system interactions with real-world impacts and code implementations.',
									link: '',
								})

							.vlt-gap-60

						.col-md-6

							+vlt_animation_block({
								delay: '300ms'
							})

								+vlt_services({
									title: 'Back-end Development',
									text: 'Design and implementation of APIs, business logic, and data models, with a strong focus on optimisation, reliability, maintainability, and scalability.',
									link: '',
								})

							.vlt-gap-60

						.col-md-6

							+vlt_animation_block({
								delay: '400ms'
							})

								+vlt_services({
									title: 'Development Workflow & Quality',
									text: 'Establishing development practices and environments that support quality, delivery efficiency, and developer productivity.',
									link: '',
								})

							.vlt-gap-60

						.col-md-6

							+vlt_animation_block({
								delay: '500ms'
							})

								+vlt_services({
									title: 'Front‑End Development',
									text: 'Responsive interfaces, mobile‑first design, client‑side performance optimization, and focus on usability and UX consistency across applications.',
									link: '',
								})

							.vlt-gap-60--sm
